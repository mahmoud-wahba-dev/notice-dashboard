{
  "name": "tailwindcss-default-admin-template",
  "version": "1.0.0",
  "description": "Default dashboard layout with vertical sidebar navigation",
  "main": "index.html",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./assets/dist/css/output.css --minify",
    "build:css": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./assets/dist/css/output.css",
    "watch": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./assets/dist/css/output.css --watch",
    "serve": "http-server . -p 8080 -o html/index.html",
    "dev": "npm run watch & npm run serve"
  },
  "keywords": [
    "tailwindcss",
    "css",
    "javascript",
    "production",
    "flyonui",
    "dashboard-default"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "apexcharts": "4.7.0",
    "clipboard": "2.0.11",
    "datatables.net": "2.3.3",
    "datatables.net-buttons": "3.2.4",
    "datatables.net-fixedcolumns": "5.0.4",
    "datatables.net-fixedheader": "4.0.3",
    "dropzone": "6.0.0-beta.2",
    "flatpickr": "4.6.13",
    "flyonui": "2.4.0",
    "jquery": "3.7.1",
    "jszip": "3.10.1",
    "lodash": "4.17.21",
    "nouislider": "15.8.1",
    "pdfmake": "0.2.20"
  },
  "devDependencies": {
    "@iconify-json/tabler": "1.2.22",
    "@iconify/json": "2.2.379",
    "@iconify/tailwind4": "1.0.6",
    "@tailwindcss/cli": "4.1.12",
    "http-server": "14.1.1",
    "tailwindcss": "4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
